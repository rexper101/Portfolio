{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Portfolio (No Localhost Needed)",
      "type": "msedge",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "name": "Open Portfolio on Localhost 8080",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}"
    }
  ]
}